rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function administradorActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true;
    }

    function categoriaRecovaValida(datos) {
      return datos.get('categoria', '') in [
        'fermentos',
        'panes_artesanales',
        'semillas_granos',
        'conservas_bebidas'
      ];
    }

    // Cierre por defecto para cualquier colección no declarada abajo.
    match /{document=**} {
      allow read, write: if false;
    }

    match /administradores/{administradorId} {
      // Cada usuario solo puede comprobar su propio documento de rol.
      // La creación y los cambios de roles se hacen desde Firebase Console.
      allow get: if autenticado() && request.auth.uid == administradorId;
      allow list, create, update, delete: if false;
    }

    match /talleristas/{talleristaId} {
      allow read: if true;
      allow create, update, delete:
        if autenticado() && request.auth.uid == talleristaId;
    }

    match /talleres/{tallerId} {
      allow read: if true;

      allow create:
        if autenticado()
        && request.resource.data.id_tallerista == request.auth.uid;

      allow update:
        if autenticado()
        && resource.data.id_tallerista == request.auth.uid
        && request.resource.data.id_tallerista == request.auth.uid;

      allow delete:
        if autenticado()
        && resource.data.id_tallerista == request.auth.uid;
    }

    match /productos/{productoId} {
      allow read: if true;

      // Talleristas publican en El Aparador. La Recova requiere administrador
      // activo y una de las cuatro categorías aprobadas.
      allow create:
        if autenticado()
        && request.resource.data.id_tallerista == request.auth.uid
        && (
          request.resource.data.tipo == 'arte'
          || (
            request.resource.data.tipo == 'mercado'
            && administradorActivo()
            && categoriaRecovaValida(request.resource.data)
          )
        );

      // Los productos antiguos sin tipo continúan tratándose como arte.
      // Mercado solo puede ser editado por su administrador y con categoría válida.
      allow update:
        if autenticado()
        && resource.data.id_tallerista == request.auth.uid
        && request.resource.data.id_tallerista == request.auth.uid
        && (
          (
            resource.data.get('tipo', 'arte') == 'arte'
            && request.resource.data.get('tipo', 'arte') == 'arte'
          )
          || (
            administradorActivo()
            && resource.data.get('tipo', '') == 'mercado'
            && request.resource.data.get('tipo', '') == 'mercado'
            && categoriaRecovaValida(request.resource.data)
          )
        );

      allow delete:
        if autenticado()
        && resource.data.id_tallerista == request.auth.uid
        && (
          resource.data.get('tipo', 'arte') == 'arte'
          || (
            administradorActivo()
            && resource.data.get('tipo', '') == 'mercado'
          )
        );
    }

    match /solicitudes/{solicitudId} {
      allow create: if true;

      allow read, update, delete:
        if autenticado()
        && resource.data.id_tallerista == request.auth.uid;
    }
  }
}
