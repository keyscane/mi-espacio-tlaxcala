---
import Layout from '../layouts/Layout.astro';
import { contacto, perfilesInstagram } from '../data/instagram';
---

<Layout title="Espacio Independencia 46 | Talleres y Cultura en Tlaxcala">
  <!-- NAV BAR -->
  <nav class="bg-white shadow-sm sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="font-bold text-xl text-gray-800 tracking-tight">
        Independencia<span class="text-[#b64e35]">46</span>
      </div>
      <div class="hidden md:flex items-center gap-6 text-sm font-semibold text-gray-600">
        <a href="#talleres" class="hover:text-[#b64e35] transition-colors">Talleres</a>
        <a href="/el-aparador" class="hover:text-[#b64e35] transition-colors">El Aparador</a>
        <a href="/la-recova" class="hover:text-[#b64e35] transition-colors">La Recova</a>
        <a href="#comunidad" class="hover:text-[#b64e35] transition-colors">Comunidad</a>
      </div>
      <div class="flex md:hidden items-center gap-4 text-sm font-semibold text-gray-600">
        <a href="#talleres" class="hover:text-[#b64e35] transition-colors">Talleres</a>
        <a href="#comunidad" class="hover:text-[#b64e35] transition-colors">Comunidad</a>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION CON CARRUSEL DE FONDO -->
  <section class="relative h-[85vh] min-h-125 flex items-center justify-center overflow-hidden bg-gray-900 text-white">
    
    <!-- Capa de Imágenes (Carrusel) -->
    <div id="hero-carousel" class="absolute inset-0 z-0">
      <img src="https://upload.wikimedia.org/wikipedia/commons/d/d8/Vista_nocturna_Bas%C3%ADlica_de_Ocotl%C3%A1n.jpg?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original" class="hero-img absolute inset-0 w-full h-full object-cover opacity-100 transition-opacity duration-1000" alt="Espacio de cerámica" />
      <img src="https://upload.wikimedia.org/wikipedia/commons/f/f3/Entre_arboles_campanario.JPG?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original" class="hero-img absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000" alt="Taller de acuarela2" />
      <img src="https://upload.wikimedia.org/wikipedia/commons/8/81/Centro%2C_Tlaxcala_de_Xicoht%C3%A9ncatl%2C_Tlax.%2C_Mexico_-_panoramio_%28292%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original" class="hero-img absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000" alt="Instalaciones Independencia 46" />
    </div>

    <!-- Overlay Gradiente (Asegura legibilidad del texto sobre cualquier foto) -->
    <div class="absolute inset-0 z-10 bg-linear-to-t from-black/80 via-black/50 to-black/30"></div>

    <!-- Contenido del Hero -->
    <div class="relative z-20 max-w-4xl mx-auto px-6 text-center flex flex-col items-center">
      <span class="px-3 py-1 bg-[#70527f]/75 text-white backdrop-blur-md rounded-full text-xs font-semibold mb-6 tracking-wide uppercase border border-[#c8b1d4]/50">
        Centro de Creación y Encuentro
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight drop-shadow-md">
        Aprende, crea y conecta en <br class="hidden md:block" /> 
        el corazón de <span class="text-[#d8c2e4]">Tlaxcala</span>.
      </h1>
      <p class="text-lg md:text-xl text-gray-200 mb-10 max-w-2xl drop-shadow-sm">
        Un espacio dedicado a las artes manuales, el desarrollo personal y la comunidad. Descubre nuestra oferta de talleres de cerámica, acuarela, euritmia y más.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href="#talleres" class="bg-[#b64e35] hover:bg-[#963f2c] text-white font-semibold px-6 py-3 rounded-xl transition-colors shadow-lg">
          Ver agenda de talleres
        </a>
        <a href="#ubicacion" class="bg-[#70527f]/40 hover:bg-[#70527f]/65 text-white border border-[#d8c2e4]/50 backdrop-blur-md font-medium px-6 py-3 rounded-xl transition-colors">¿Cómo llegar?</a>
      </div>
    </div>
  </section>

<script>
  document.addEventListener('astro:page-load', () => {
    const imagenes = document.querySelectorAll('.hero-img');
    const carouselWindow = window as Window & { __heroCarouselTimer?: number };
    let indexActual = 0;
    if (imagenes.length > 0) {
      carouselWindow.clearInterval(carouselWindow.__heroCarouselTimer);
      carouselWindow.__heroCarouselTimer = carouselWindow.setInterval(() => {
        imagenes[indexActual].classList.remove('opacity-100');
        imagenes[indexActual].classList.add('opacity-0');
        indexActual = (indexActual + 1) % imagenes.length;
        imagenes[indexActual].classList.remove('opacity-0');
        imagenes[indexActual].classList.add('opacity-100');
      }, 5000);
    }
  });
</script>

  <!-- TABLERO DE TALLERES -->
  <section id="talleres" class="py-20 bg-[#f7f4ed]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="mb-12">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#70527f] mb-3">Aprender haciendo</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#30291f] mb-4">Agenda de talleres</h2>
        <p class="text-[#625747]">Toca un taller para ver fechas, conocer al instructor e inscribirte.</p>
      </div>

      <div id="grid-talleres" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
  <p class="text-gray-500 col-span-full text-center py-8">
    Cargando talleres...
  </p>
      </div>
    </div>
  </section>

  <!-- PUENTE ENTRE LOS TALLERES Y LOS CATÁLOGOS -->
  <section id="catalogos" class="py-20 bg-[#e9e0cf]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#a64b32] mb-3">Hecho aquí, para llevar</p>
        <h2 class="text-3xl md:text-4xl font-black text-[#30291f]">Del taller a tu casa y a tu mesa.</h2>
        <p class="text-[#625747] mt-3">Piezas únicas y productos de la región, creados por nuestra comunidad.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-7">
        <article class="group min-h-97.5 overflow-hidden rounded-sm bg-[#f5f2ea] border border-[#d5cbb8] shadow-sm flex flex-col">
          <div class="relative h-52 sm:h-60 overflow-hidden bg-[#c9c7b9]">
            <img src="/aparador-portada.svg" alt="Ilustración editorial de una pieza de cerámica contemporánea en una galería clara" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute left-5 top-5 bg-[#f7f1e4] px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#5c5142]">Piezas de autor</span>
          </div>
          <div class="p-7 flex flex-col flex-1 items-start">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#a64b32]">Arte · cerámica · oficio</p>
            <h3 class="text-3xl font-black text-[#30291f] mt-2">El Aparador</h3>
            <p class="text-[#625747] mt-2 mb-6">Galería de piezas únicas y objetos de autor creados en nuestros talleres.</p>
            <a href="/el-aparador" class="mt-auto inline-flex items-center gap-2 bg-[#a64b32] hover:bg-[#813b2a] text-white font-bold px-5 py-3 transition-colors">Explorar el Aparador de Arte <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <article class="group min-h-97.5 overflow-hidden rounded-sm bg-[#d9d2b9] border border-[#bdb397] shadow-sm flex flex-col">
          <div class="relative h-52 sm:h-60 overflow-hidden bg-[#85835a]">
            <img src="/recova-portada.svg" alt="Bodegón ilustrado de alimentos artesanales y fermentos" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <span class="absolute left-5 top-5 bg-[#eee8d7] px-3 py-1 text-xs font-bold uppercase tracking-widest text-[#4b5035]">Despensa de la región</span>
          </div>
          <div class="p-7 flex flex-col flex-1 items-start">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#59613f]">Alimentos vivos · origen local</p>
            <h3 class="text-3xl font-black text-[#30291f] mt-2">La Recova</h3>
            <p class="text-[#514d3b] mt-2 mb-6">Mercado de alimentos vivos, productos orgánicos y despensa artesanal de la región.</p>
            <a href="/la-recova" class="mt-auto inline-flex items-center gap-2 bg-[#59613f] hover:bg-[#41472f] text-white font-bold px-5 py-3 transition-colors">Visitar el Mercado Artesanal <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- COMUNIDAD Y REDES -->
  <section id="comunidad" class="scroll-mt-20">
  <section class="py-20 bg-[#34382f] text-white overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 text-center mb-16">
      <h2 class="text-3xl font-bold mb-6">¿Buscas un espacio para impartir tu taller?</h2>
      <p class="text-[#eee8da] text-lg mb-8">
        Si eres tallerista o artesano y necesitas infraestructura para tus clases, Av. Independencia 46 tiene las puertas abiertas para sumar nuevas disciplinas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent('Hola, soy instructor y me gustaría proponer un taller.')}`}
          class="bg-[#b64e35] hover:bg-[#963f2c] text-white font-bold px-8 py-3 rounded-lg transition-colors shadow-lg flex items-center justify-center gap-2"
        >
          Proponer por WhatsApp
        </a>
        <button
          id="btn-mostrar-correo"
          type="button"
          aria-expanded="false"
          aria-controls="correo-contacto"
          class="bg-transparent border border-[#b9a2c7] hover:bg-[#70527f]/30 text-[#e0cde9] font-bold px-8 py-3 rounded-lg transition-colors flex items-center justify-center gap-2"
        >
          Mostrar correo
        </button>
      </div>
      <div id="correo-contacto" class="hidden mt-5 flex-col items-center justify-center gap-3 text-sm" aria-live="polite">
        <a href={`mailto:${contacto.correo}`} class="text-[#e0cde9] underline underline-offset-4">{contacto.correo}</a>
        <button id="btn-copiar-correo" type="button" class="rounded-md border border-[#b9a2c7]/60 px-4 py-2 text-[#eee8da] hover:bg-[#70527f]/30 transition-colors">
          Copiar correo
        </button>
        <span id="estado-copiar-correo" class="text-xs text-[#eee8da]" role="status"></span>
      </div>
    </div>

    <!-- Banner dinámico de Redes Sociales (CSS Marquee) -->
    <div class="border-y border-[#b9a2c7]/25 py-6 bg-[#70527f]/15 flex overflow-hidden group">
      <div class="flex w-max animate-marquee whitespace-nowrap group-hover:[animation-play-state:paused]">
        {[0, 1].map((copia) => (
          <div class="flex shrink-0 items-center gap-12 pr-12" aria-hidden={copia === 1 ? 'true' : undefined}>
            {perfilesInstagram.map((perfil, indice) => (
              <>
                <a
                  href={perfil.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#ddcbe7]/75 font-mono text-lg hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                  aria-label={`Abrir Instagram de @${perfil.usuario} en una pestaña nueva`}
                  tabindex={copia === 1 ? -1 : undefined}
                >@{perfil.usuario}</a>
                {indice < perfilesInstagram.length - 1 && <span class="text-[#ddcbe7]/75" aria-hidden="true">•</span>}
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- MAPA Y UBICACIÓN -->
  <section id="ubicacion" class="py-20 bg-[#f7f4ed] border-t border-[#e3ddd2]">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold text-[#30291f] mb-4">Encuéntranos</h2>
        <p class="text-[#625747] mb-8 leading-relaxed">
          Nuestras instalaciones están adaptadas para la creación manual, rodeadas de un ambiente que fomenta la tranquilidad y el aprendizaje continuo en el corazón de la ciudad.
        </p>
        <ul class="space-y-5 text-[#514d43]">
          <li class="flex items-start gap-4">
            <div class="bg-[#e5e7db] p-2 rounded-lg shrink-0">
              <svg class="w-6 h-6 text-[#59613f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <p class="font-bold text-[#30291f]">Dirección</p>
              <p class="text-sm mt-1">Av. Independencia #46, Tlaxcala Centro, Tlax.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="bg-[#e5e7db] p-2 rounded-lg shrink-0">
              <svg class="w-6 h-6 text-[#59613f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <p class="font-bold text-[#30291f]">Horarios de acceso</p>
              <p class="text-sm mt-1">El acceso al espacio está sujeto a la programación y duración de cada taller.</p>
            </div>
          </li>
        </ul>
      </div>
      
      <!-- Contenedor del Mapa (Iframe de Google Maps) -->
      <div class="h-96 bg-[#e9e0cf] rounded-sm overflow-hidden shadow-md border border-[#d5cbb8] relative group">
        <!-- Overlay sutil que desaparece al pasar el cursor para que el mapa resalte -->
        <div class="absolute inset-0 bg-[#30291f]/5 group-hover:bg-transparent transition-colors pointer-events-none z-10"></div>
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d941.3423700195157!2d-98.24104463049704!3d19.309766998871492!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cfd91e023fe25d%3A0x713b24f00b9a3d68!2sCasona%20Independecia46!5e0!3m2!1ses-419!2smx!4v1791209587115!5m2!1ses-419!2smx"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Independencia 46 en Tlaxcala"
          class="relative z-0">
        </iframe>
      </div>
    </div>
  </section>
  </section>

  <!-- FOOTER Y CONTACTO OCULTO -->
  <footer class="bg-gray-900 text-gray-400 py-12 text-sm border-t border-gray-800">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="font-bold text-white text-lg mb-2">Independencia 46</p>
        <p>Av. Independencia #46, Tlaxcala Centro, Tlax.</p>
        <p class="mt-2">contacto@independencia46.space</p>
      </div>
      <div class="md:text-right flex flex-col md:items-end">
        <p class="mb-4">© 2026 Todos los derechos reservados.</p>
        
   <!-- Botón discreto para enlace personal -->
<div id="seccion-secreta" class="inline-flex items-center">
  <button
    id="btn-revelar-web"
    type="button"
    aria-label="Mostrar portal de consultas personales"
    class="p-3 -m-3 text-[10px] leading-none text-gray-700 hover:text-gray-400 focus-visible:text-gray-400 transition-colors"
  >
    ·
  </button>
  <a id="link-secreto"
    href="https://muelle.xyz"
    target="_blank"
    rel="noopener noreferrer"
    class="hidden text-[10px] text-gray-500 hover:text-[#b64e35] transition-colors"
  >
    Portal →
  </a>
</div>
      </div>
    </div>
  </footer>

  <!-- MODAL DE DETALLES DEL TALLER (Oculto por defecto) -->
  <div id="modal-taller" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 px-4">
    <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl transform scale-95 transition-transform duration-300" id="modal-content">
      
      <!-- Imagen y Botón Cerrar -->
      <div class="relative h-48 sm:h-64 bg-gray-200">
        <img id="m-imagen" src="" class="w-full h-full object-cover" />
        <button id="btn-cerrar-modal" class="absolute top-4 right-4 bg-white/80 hover:bg-white text-gray-900 w-8 h-8 rounded-full flex items-center justify-center shadow backdrop-blur-sm transition-colors font-bold">
          ✕
        </button>
      </div>

      <div class="p-6 md:p-8">
        <h2 id="m-titulo" class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-2">Título</h2>
        
        <!-- Bloque Fechas -->
        <div class="flex items-start gap-3 bg-[#f0ebf3] text-[#51405d] p-4 rounded-xl border border-[#e0d6e6] mb-6">
          <svg class="w-6 h-6 shrink-0 text-[#70527f] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <p id="m-fechas" class="font-medium text-sm md:text-base leading-snug"></p>
        </div>

        <p id="m-desc" class="text-gray-600 mb-8 leading-relaxed"></p>

        <!-- Bloque Instructor (Biografía) -->
        <div class="border-t border-gray-100 pt-6 mb-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <img id="m-foto" src="" class="w-16 h-16 rounded-full bg-gray-100 border-2 border-[#d9d2b9] object-cover" />
          <div>
            <p class="text-xs text-gray-400 uppercase tracking-wider font-bold mb-1">Imparte</p>
            <p id="m-instructor" class="font-bold text-gray-900 text-lg"></p>
            <p id="m-bio" class="text-sm text-gray-500 mt-1 line-clamp-3"></p>
          </div>
        </div>

        <!-- Botón de Acción -->
        <a id="m-wa" href="#" target="_blank" class="block w-full text-center bg-[#b64e35] hover:bg-[#963f2c] text-white font-bold py-3.5 rounded-xl transition-colors shadow-lg shadow-[#b64e35]/20">
          Inscribirme por WhatsApp
        </a>
      </div>
    </div>
  </div>

</Layout>

<style>
  /* Animación para el banner de Redes Sociales */
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
</style>

<script>
  import { getTalleresActivos } from '../lib/admin';
  import { getTalleristasActivos } from '../lib/firebase';

  type DatosModal = {
    titulo: string | null;
    imagen: string | null;
    instructor: string | null;
    bio: string | null;
    fotoInstructor: string | null;
    fechas: string | null;
    desc: string | null;
    wa: string | null;
  };

  function inicializarPortada() {

  // =========================================================
  // REFERENCIAS DEL MODAL
  // =========================================================

  const modal = document.getElementById('modal-taller');
  const modalContent = document.getElementById('modal-content');
  const btnCerrar = document.getElementById('btn-cerrar-modal');

  const mTitulo = document.getElementById('m-titulo');
  const mImagen = document.getElementById('m-imagen');
  const mInstructor = document.getElementById('m-instructor');
  const mBio = document.getElementById('m-bio');
  const mFoto = document.getElementById('m-foto');
  const mFechas = document.getElementById('m-fechas');
  const mDesc = document.getElementById('m-desc');
  const mWa = document.getElementById('m-wa');


  // =========================================================
  // ABRIR MODAL
  // =========================================================

  function abrirModal(datos: DatosModal) {
    if (mTitulo) mTitulo.textContent = datos.titulo || '';
    if (mImagen instanceof HTMLImageElement) mImagen.src = datos.imagen || '';
    if (mInstructor) mInstructor.textContent = datos.instructor || '';
    if (mBio) mBio.textContent = datos.bio || '';
    if (mFoto instanceof HTMLImageElement) mFoto.src = datos.fotoInstructor || '';
    if (mFechas) mFechas.textContent = datos.fechas || '';
    if (mDesc) mDesc.textContent = datos.desc || '';
    if (mWa instanceof HTMLAnchorElement) mWa.href = datos.wa || '#';

    modal?.classList.remove('opacity-0', 'pointer-events-none');
    modalContent?.classList.remove('scale-95');

    document.body.style.overflow = 'hidden';
  }


  // =========================================================
  // CERRAR MODAL
  // =========================================================

  function cerrarModal() {
    modal?.classList.add('opacity-0', 'pointer-events-none');
    modalContent?.classList.add('scale-95');

    document.body.style.overflow = 'auto';
  }


  // =========================================================
  // ASIGNAR EVENTOS A TARJETAS
  // =========================================================

  function asignarEventosModal() {
    document.querySelectorAll('.btn-abrir-modal').forEach(tarjeta => {

      tarjeta.addEventListener('click', () => {

        const datos = {
          titulo: tarjeta.getAttribute('data-titulo'),
          imagen: tarjeta.getAttribute('data-imagen'),
          instructor: tarjeta.getAttribute('data-instructor'),
          bio: tarjeta.getAttribute('data-bio'),
          fotoInstructor: tarjeta.getAttribute('data-foto-instructor'),
          fechas: tarjeta.getAttribute('data-fechas'),
          desc: tarjeta.getAttribute('data-desc'),
          wa: tarjeta.getAttribute('data-wa'),
        };

        abrirModal(datos);
      });

    });
  }


  // =========================================================
  // CARGAR TALLERES DESDE FIRESTORE
  // =========================================================

  async function renderizarTalleres() {

    const grid = document.getElementById('grid-talleres');

    if (!grid) return;

    try {

      const [talleres, talleristas] = await Promise.all([
        getTalleresActivos(),
        getTalleristasActivos()
      ]);

      // Crear mapa de talleristas para buscar rápidamente
      const talleristasMap = new Map(
        talleristas.map(t => [t.id, t])
      );


      // Si no existen talleres
      if (talleres.length === 0) {

        grid.innerHTML = `
          <p class="text-gray-500 col-span-full text-center py-8">
            Próximamente publicaremos los nuevos talleres del ciclo.
          </p>
        `;

        return;
      }


      // Generar tarjetas
      grid.innerHTML = talleres.map((taller) => {

        const instructor = talleristasMap.get(taller.id_tallerista) || {
          nombre: 'Instructor Registrado',
          bio: 'Instructor del espacio Independencia 46.',
          whatsapp_ventas: '2460000000',
          foto_url: ''
        };


        const msgWA = encodeURIComponent(
          `Hola ${instructor.nombre}, me interesa inscribirme al taller "${taller.titulo}" que vi en Independencia 46.`
        );

        const linkWA = `https://wa.me/${instructor.whatsapp_ventas}?text=${msgWA}`;


        return `
          <article
            class="bg-white rounded-sm border border-[#e3ddd2] shadow-sm hover:shadow-lg hover:border-[#b64e35]/50 transition-all cursor-pointer overflow-hidden flex flex-col group btn-abrir-modal"

            data-titulo="${taller.titulo}"
            data-imagen="${taller.imagen_url}"
            data-instructor="${instructor.nombre}"
            data-bio="${instructor.bio || 'Sin biografía disponible.'}"
            data-foto-instructor="${instructor.foto_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(instructor.nombre)}`}"
            data-fechas="${taller.fechas_horario}"
            data-desc="${taller.descripcion}"
            data-wa="${linkWA}"
          >

            <div class="h-48 relative overflow-hidden bg-gray-100">

              <img
                src="${taller.imagen_url}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                alt="${taller.titulo}"
                onerror="this.src='https://picsum.photos/600/400'"
              />

              <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-gray-800 shadow-sm">
                ${taller.fechas_horario?.split('|')[0] || 'Horario a consultar'}
              </div>

              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="text-white font-semibold bg-[#59613f]/95 px-4 py-2 rounded-full text-sm">
                  Ver detalles del taller
                </span>
              </div>

            </div>


            <div class="p-6">

              <h3 class="text-xl font-bold text-gray-900 mb-2">
                ${taller.titulo}
              </h3>

              <p class="text-gray-500 text-sm mb-4 line-clamp-2">
                ${taller.descripcion}
              </p>

              <div class="flex items-center gap-2 border-t border-[#eee9df] pt-4">

                ${instructor.foto_url
                  ? `<img src="${instructor.foto_url}" alt="Foto de ${instructor.nombre}" class="w-7 h-7 rounded-full object-cover border border-[#d9d2b9]" loading="lazy" />`
                  : `<div class="w-7 h-7 rounded-full bg-[#e5e7db] text-[#59613f] flex items-center justify-center font-bold text-xs">${instructor.nombre?.charAt(0) || 'I'}</div>`}

                <span class="text-sm font-medium text-gray-700">
                  Por: ${instructor.nombre}
                </span>

              </div>

            </div>

          </article>
        `;

      }).join('');


      // Activar los clicks del modal
      asignarEventosModal();

    } catch (e) {

      console.error('Error cargando talleres:', e);

      grid.innerHTML = `
        <p class="text-red-500 col-span-full text-center py-8">
          No fue posible cargar los talleres en este momento.
        </p>
      `;
    }
  }


  // =========================================================
  // EVENTOS
  // =========================================================

  btnCerrar?.addEventListener('click', cerrarModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      cerrarModal();
    }
  });


  // =========================================================
  // ENLACE OCULTO
  // =========================================================

  const btnRevelar = document.getElementById('btn-revelar-web');
  const linkSecreto = document.getElementById('link-secreto');

  btnRevelar?.addEventListener('click', () => {

    btnRevelar.classList.add('hidden');

    linkSecreto?.classList.remove('hidden');
  });

  const btnMostrarCorreo = document.getElementById('btn-mostrar-correo');
  const correoContacto = document.getElementById('correo-contacto');
  const btnCopiarCorreo = document.getElementById('btn-copiar-correo');
  const estadoCopiarCorreo = document.getElementById('estado-copiar-correo');

  btnMostrarCorreo?.addEventListener('click', () => {
    const mostrar = btnMostrarCorreo.getAttribute('aria-expanded') !== 'true';
    btnMostrarCorreo.setAttribute('aria-expanded', String(mostrar));
    correoContacto?.classList.toggle('hidden', !mostrar);
    correoContacto?.classList.toggle('flex', mostrar);
    btnMostrarCorreo.textContent = mostrar ? 'Ocultar correo' : 'Mostrar correo';
  });

  btnCopiarCorreo?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(contacto.correo);
      if (estadoCopiarCorreo) estadoCopiarCorreo.textContent = 'Correo copiado.';
    } catch {
      if (estadoCopiarCorreo) estadoCopiarCorreo.textContent = 'Selecciona y copia la dirección de correo mostrada.';
    }
  });


  // =========================================================
  // INICIAR CARGA
  // =========================================================

  renderizarTalleres();
  }

  document.addEventListener('astro:page-load', inicializarPortada);
</script>
