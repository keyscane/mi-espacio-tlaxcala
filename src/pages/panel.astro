---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel de Talleristas">
  <main class="max-w-4xl mx-auto p-6 mt-10">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">Panel Privado de Gestión</h1>

    <!-- ESTADO DE CARGA -->
    <div id="loading-section" class="flex justify-center items-center py-10">
      <p class="text-gray-500 animate-pulse">Verificando sesión en Firebase...</p>
    </div>

    <!-- SECCIÓN DE LOGIN (Oculta por defecto para evitar parpadeos) -->
    <div id="login-section" class="hidden bg-white p-6 rounded shadow-md max-w-md mx-auto border border-gray-200">
      <h2 class="text-xl mb-4 font-semibold">Iniciar Sesión</h2>
      <form id="login-form">
        <input type="email" id="email" placeholder="Correo electrónico" class="w-full mb-3 p-2 border rounded focus:ring-2 focus:ring-blue-500" required />
        <input type="password" id="password" placeholder="Contraseña" class="w-full mb-3 p-2 border rounded focus:ring-2 focus:ring-blue-500" required />
        <button type="submit" id="btn-login" class="w-full bg-blue-600 text-white font-bold p-2 rounded hover:bg-blue-700 transition">Entrar</button>
      </form>
      <p id="login-error" class="text-red-500 mt-2 hidden text-sm"></p>
    </div>

    <!-- SECCIÓN DEL DASHBOARD (Oculta hasta iniciar sesión) -->
    <div id="dashboard-section" class="hidden">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl text-gray-700">Bienvenido, Instructor</h2>
        <button id="btn-logout" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded transition">Cerrar Sesión</button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Formulario Perfil -->
        <div class="bg-white p-6 rounded shadow-md border border-gray-200">
          <h3 class="text-lg font-bold mb-4 text-gray-800">Mi Perfil y Contacto P2P</h3>
          <label class="block text-sm text-gray-600 mb-1">Nombre Completo</label>
          <input type="text" id="perfil-nombre" placeholder="Ej. Yael..." class="w-full mb-3 p-2 border rounded" />
          
          <label class="block text-sm text-gray-600 mb-1">Biografía Breve</label>
          <textarea id="perfil-bio" placeholder="Acerca de tu trabajo..." class="w-full mb-3 p-2 border rounded h-24"></textarea>
          
          <label class="block text-sm text-gray-600 mb-1">WhatsApp (Para ventas P2P)</label>
          <input type="text" id="perfil-whatsapp" placeholder="Ej. +522461234567" class="w-full mb-4 p-2 border rounded" />
          
          <button id="btn-perfil" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold p-2 rounded transition">Guardar y Actualizar Sitio</button>
        </div>

        <!-- Formulario Producto -->
        <div class="bg-white p-6 rounded shadow-md border border-gray-200">
          <h3 class="text-lg font-bold mb-4 text-gray-800">Subir Nuevo Producto al Aparador</h3>
          <input type="text" id="prod-titulo" placeholder="Título del producto o kit" class="w-full mb-3 p-2 border rounded" />
          <textarea id="prod-desc" placeholder="Descripción detallada" class="w-full mb-3 p-2 border rounded h-24"></textarea>
          <input type="number" id="prod-precio" placeholder="Precio final ($)" class="w-full mb-3 p-2 border rounded" />
          
          <label class="block text-sm text-gray-600 mb-1">Imagen del Producto</label>
          <input type="file" id="prod-imagen" accept="image/*" class="w-full mb-4 p-2 border rounded" />
          
          <button id="btn-producto" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold p-2 rounded transition">Publicar Producto</button>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  import { auth } from '../lib/firebase';
  import { signInWithEmailAndPassword, onAuthStateChanged, signOut } from 'firebase/auth';
  import { actualizarPerfilTallerista, crearProductoP2P } from '../lib/admin';

  document.addEventListener('DOMContentLoaded', () => {
    // Referencias a los contenedores
    const loadingSection = document.getElementById('loading-section');
    const loginSection = document.getElementById('login-section');
    const dashboardSection = document.getElementById('dashboard-section');
    let currentUserId: string | null = null;

    // Escuchar el estado de autenticación
    onAuthStateChanged(auth, (user) => {
      loadingSection?.classList.add('hidden'); // Quita el mensaje de carga
      
      if (user) {
        currentUserId = user.uid;
        loginSection?.classList.add('hidden');
        dashboardSection?.classList.remove('hidden');
      } else {
        currentUserId = null;
        loginSection?.classList.remove('hidden');
        dashboardSection?.classList.add('hidden');
      }
    });

    // Evento: Iniciar Sesión (Usando 'submit' para que funcione el Enter)
    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault(); // Evita que la página intente recargarse
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const pass = (document.getElementById('password') as HTMLInputElement).value;
      try {
        await signInWithEmailAndPassword(auth, email, pass);
      } catch (error) {
        const errEl = document.getElementById('login-error');
        if (errEl) {
          errEl.innerText = "Credenciales inválidas o usuario no encontrado.";
          errEl.classList.remove('hidden');
        }
      }
    });

    // Botón: Cerrar Sesión
    document.getElementById('btn-logout')?.addEventListener('click', () => {
      signOut(auth);
    });

    // Botón: Actualizar Perfil (Con bloqueo anti-doble clic)
    document.getElementById('btn-perfil')?.addEventListener('click', async () => {
      if (!currentUserId) return;
      const btn = document.getElementById('btn-perfil') as HTMLButtonElement;
      const nombre = (document.getElementById('perfil-nombre') as HTMLInputElement).value;
      const bio = (document.getElementById('perfil-bio') as HTMLTextAreaElement).value;
      const whatsapp = (document.getElementById('perfil-whatsapp') as HTMLInputElement).value;
      
      btn.innerText = "Guardando...";
      btn.disabled = true; // Bloquea el botón
      
      try {
        await actualizarPerfilTallerista(currentUserId, { nombre, bio, contacto: '', whatsapp_ventas: whatsapp });
        alert('Perfil guardado. Netlify está reconstruyendo tu sitio web ahora mismo.');
      } catch (error) {
        alert('Error al guardar el perfil.');
      } finally {
        btn.innerText = "Guardar y Actualizar Sitio";
        btn.disabled = false; // Desbloquea el botón
      }
    });

    // Botón: Subir Producto
    document.getElementById('btn-producto')?.addEventListener('click', async () => {
      if (!currentUserId) return;
      const btn = document.getElementById('btn-producto') as HTMLButtonElement;
      const titulo = (document.getElementById('prod-titulo') as HTMLInputElement).value;
      const desc = (document.getElementById('prod-desc') as HTMLTextAreaElement).value;
      const precio = (document.getElementById('prod-precio') as HTMLInputElement).value;
      const archivo = (document.getElementById('prod-imagen') as HTMLInputElement).files?.[0];
      
      if (!archivo || !titulo || !precio) {
        return alert('Por favor, completa los campos y selecciona una imagen.');
      }

      btn.innerText = "Subiendo imagen y guardando...";
      btn.disabled = true;
      
      try {
        await crearProductoP2P(currentUserId, titulo, desc, Number(precio), archivo);
        alert('¡Producto publicado con éxito! Netlify está recompilando el catálogo.');
        
        // Limpiar formulario
        (document.getElementById('prod-titulo') as HTMLInputElement).value = '';
        (document.getElementById('prod-desc') as HTMLTextAreaElement).value = '';
        (document.getElementById('prod-precio') as HTMLInputElement).value = '';
        (document.getElementById('prod-imagen') as HTMLInputElement).value = '';
      } catch (error) {
        console.error(error);
        alert('Error al publicar el producto.');
      } finally {
        btn.innerText = "Publicar Producto";
        btn.disabled = false;
      }
    });
  });
</script>