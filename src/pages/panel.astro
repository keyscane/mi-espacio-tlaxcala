---

import Layout from '../layouts/Layout.astro';

---



<Layout title="Panel de Instructor | Talleres Tlaxcala" transitions={false}>

  <!-- Pasamos las variables de entorno al HTML como data attributes -->

  <main 

    id="main-container"

    data-cloud={import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME}

    data-preset={import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET}

    class="max-w-4xl mx-auto p-6 my-10"

  >



    <!-- ========================================== -->

    <!-- ESTADO 1: FORMULARIO DE ACCESO (LOGIN) -->

    <!-- ========================================== -->

    <section id="seccion-login" class="hidden max-w-md mx-auto bg-white p-8 rounded-xl shadow-sm border border-gray-100 mt-10">

      <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Acceso a Instructores</h2>

      <form id="form-login" class="space-y-4">

        <div>

          <label class="block text-sm font-medium text-gray-700 mb-1">Correo electrónico</label>

          <input type="email" id="login-email" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />

        </div>

        <div>

          <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>

          <input type="password" id="login-password" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />

        </div>

        <p id="msg-login-error" class="text-red-500 text-sm hidden"></p>

        <button type="submit" id="btn-login" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2 rounded-lg transition-colors">

          Ingresar al Panel

        </button>

      </form>

    </section>



    <!-- ========================================== -->

    <!-- ESTADO 2: DASHBOARD DEL INSTRUCTOR -->

    <!-- ========================================== -->

    <div id="seccion-dashboard" class="hidden">

      <!-- Encabezado y Saludo -->

      <div class="flex justify-between items-center mb-8 border-b pb-4">

        <div>

          <h1 class="text-2xl font-bold text-gray-800">Panel de Control</h1>

          <p id="saludo-user" class="text-gray-600 text-sm">Cargando sesión...</p>

        </div>

        <button id="btn-logout" class="text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg transition-colors">

          Cerrar Sesión

        </button>

      </div>



      <!-- SECCIÓN 1: Formulario de Perfil -->

      <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8">

        <h2 class="text-xl font-bold text-gray-800 mb-1">Mi Perfil y Contacto P2P</h2>

        <p class="text-sm text-gray-500 mb-4">Esta información es pública y permite que los alumnos te contacten directamente por WhatsApp.</p>



        <div id="msg-perfil" class="hidden p-3 rounded-lg text-sm mb-4"></div>



        <form id="form-perfil" class="space-y-4">

          <div>

            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre o Firma Comercial</label>

            <input type="text" id="perfil-nombre" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Ej. Taller Artesanal Las Noas" />

          </div>



          <div>

            <label class="block text-sm font-medium text-gray-700 mb-1">Semblanza / Biografía corta</label>

            <textarea id="perfil-bio" rows="2" class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Breve descripción de tu trabajo o proyecto..."></textarea>

          </div>



          <div>

            <label class="block text-sm font-medium text-gray-700 mb-1">Foto del instructor (avatar)</label>
            <input type="file" id="perfil-foto" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700" />
            <img id="perfil-foto-preview" src="/favicon.svg" alt="Vista previa de la foto de perfil" class="mt-2 w-14 h-14 rounded-full object-cover border border-gray-200 bg-gray-50" />
            <p class="text-xs text-gray-400 mt-1">Se muestra pequeño junto a tu nombre; la imagen del taller sigue siendo independiente.</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp de Ventas (10 dígitos)</label>

            <input type="tel" id="perfil-whatsapp" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="2461234567" />

          </div>



          <button type="submit" id="btn-guardar-perfil" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">

            Guardar Perfil

          </button>

        </form>

      </section>



      <section id="seccion-recova-admin" class="hidden bg-[#f2efe5] p-6 rounded-xl shadow-sm border border-[#d8d1bd] mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-1">Publicar producto para La Recova</h2>
        <p class="text-sm text-gray-600 mb-4">Visible para usuarios con registro activo en administradores/{'{UID}'}.</p>
        <div id="msg-recova" class="hidden p-3 rounded-lg text-sm mb-4"></div>
        <form id="form-recova" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div><label for="recova-titulo" class="block text-sm font-medium text-gray-700 mb-1">Producto</label><input id="recova-titulo" required class="w-full border rounded-lg p-2 text-sm" /></div>
            <div><label for="recova-productor" class="block text-sm font-medium text-gray-700 mb-1">Productor o taller de origen</label><input id="recova-productor" required class="w-full border rounded-lg p-2 text-sm" /></div>
            <div><label for="recova-precio" class="block text-sm font-medium text-gray-700 mb-1">Precio (MXN)</label><input id="recova-precio" type="number" min="1" step="0.5" required class="w-full border rounded-lg p-2 text-sm" /></div>
            <div>
              <label for="recova-categoria" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
              <select id="recova-categoria" required class="w-full border rounded-lg p-2 text-sm">
                <option value="" disabled selected>Selecciona una categoría</option>
                <option value="fermentos">Fermentos y alimentos vivos</option>
                <option value="panes_artesanales">Panes artesanales</option>
                <option value="semillas_granos">Semillas y granos</option>
                <option value="conservas_bebidas">Conservas y bebidas</option>
              </select>
            </div>
          </div>
          <div><label for="recova-descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label><textarea id="recova-descripcion" rows="2" required class="w-full border rounded-lg p-2 text-sm"></textarea></div>
          <div><label for="recova-imagen" class="block text-sm font-medium text-gray-700 mb-1">Imagen del producto</label><input id="recova-imagen" type="file" accept="image/*" required class="w-full text-sm" /></div>
          <button id="btn-guardar-recova" type="submit" class="bg-[#59613f] hover:bg-[#41472f] text-white text-sm font-medium px-4 py-2 rounded-lg">Publicar en La Recova</button>
        </form>
      </section>

      <!-- SECCIÓN 3: Gestión de Talleres -->
      <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-1">Publicar un Nuevo Taller</h2>
        <p class="text-sm text-gray-500 mb-4">Comparte los detalles de tu próximo taller con tus alumnos.</p>
        <div id="msg-taller" class="hidden p-3 rounded-lg text-sm mb-4"></div>
        <form id="form-taller" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="taller-titulo">Título del taller</label>
            <input type="text" id="taller-titulo" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Ej. Cerámica para principiantes" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="taller-descripcion">Descripción</label>
            <textarea id="taller-descripcion" rows="3" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Describe qué aprenderán los participantes..."></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="taller-fechas-horario">Fechas y horario</label>
            <input type="text" id="taller-fechas-horario" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Sábado 12 de octubre, 10:00 a 13:00" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" for="taller-imagen">Imagen del taller</label>
            <input type="file" id="taller-imagen" accept="image/*" required class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" />
          </div>
          <button type="submit" id="btn-guardar-taller" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">Publicar Taller</button>
        </form>
      </section>

      <!-- SECCIÓN 4: Mis Talleres Publicados -->
      <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Mis Talleres Publicados</h2>
        <div id="lista-mis-talleres" class="space-y-3">
          <p class="text-gray-400 text-sm">Cargando tus talleres...</p>
        </div>
      </section>
      <!-- SECCIÓN 2: Subir Nuevo Producto -->

      <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 mb-8">

        <h2 class="text-xl font-bold text-gray-800 mb-1">Subir Producto al Aparador</h2>

        <p class="text-sm text-gray-500 mb-4">Publica kits, materiales o herramientas didácticas.</p>



        <div id="msg-producto" class="hidden p-3 rounded-lg text-sm mb-4"></div>



        <form id="form-producto" class="space-y-4">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <div>

              <label class="block text-sm font-medium text-gray-700 mb-1">Título del Producto</label>

              <input type="text" id="prod-titulo" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Ej. Kit Inicio Masa Madre" />

            </div>

            <div>

              <label class="block text-sm font-medium text-gray-700 mb-1">Precio (MXN)</label>

              <input type="number" id="prod-precio" required min="1" step="0.5" class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="250" />

            </div>

          </div>



          <div>

            <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>

            <textarea id="prod-descripcion" rows="2" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Detalla qué incluye el kit o producto..."></textarea>

          </div>



          <div>

            <label for="prod-tipo" class="block text-sm font-medium text-gray-700 mb-1">Catálogo</label>
            <select id="prod-tipo" required class="w-full border rounded-lg p-2 text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
              <option value="arte">El Aparador · arte y piezas de autor</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Imagen del Producto</label>

            <input type="file" id="prod-imagen" accept="image/*" required class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" />

          </div>



          <button type="submit" id="btn-guardar-producto" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">

            Publicar Producto

          </button>

        </form>

      </section>



      <!-- SECCIÓN 5: Mis Productos Publicados -->

      <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">

        <h2 class="text-xl font-bold text-gray-800 mb-4">Mis Productos Publicados</h2>

        <div id="lista-mis-productos" class="space-y-3">

          <p class="text-gray-400 text-sm">Cargando tus productos...</p>

        </div>

      </section>

      <div id="modal-edicion" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4 py-6" role="dialog" aria-modal="true" aria-labelledby="modal-edicion-titulo">
        <form id="form-edicion" class="w-full max-w-xl max-h-full overflow-y-auto rounded-xl bg-white p-6 shadow-xl space-y-4">
          <div class="flex items-start justify-between gap-4">
            <div><h2 id="modal-edicion-titulo" class="text-xl font-bold text-gray-800">Editar publicación</h2><p id="modal-edicion-subtitulo" class="mt-1 text-sm text-gray-500"></p></div>
            <button type="button" id="btn-cerrar-edicion" aria-label="Cerrar" class="rounded-lg px-2 py-1 text-xl text-gray-500 hover:bg-gray-100">×</button>
          </div>
          <div id="modal-edicion-error" class="hidden rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert"></div>
          <div><label for="edicion-titulo" class="mb-1 block text-sm font-medium text-gray-700">Título</label><input id="edicion-titulo" required class="w-full rounded-lg border p-2 text-sm" /></div>
          <div><label for="edicion-descripcion" class="mb-1 block text-sm font-medium text-gray-700">Descripción</label><textarea id="edicion-descripcion" rows="3" required class="w-full rounded-lg border p-2 text-sm"></textarea></div>
          <div id="campos-edicion-taller" class="hidden"><label for="edicion-fechas" class="mb-1 block text-sm font-medium text-gray-700">Fechas y horario</label><input id="edicion-fechas" class="w-full rounded-lg border p-2 text-sm" /></div>
          <div id="campos-edicion-producto" class="hidden space-y-4">
            <div><label for="edicion-precio" class="mb-1 block text-sm font-medium text-gray-700">Precio (MXN)</label><input id="edicion-precio" type="number" min="1" step="0.5" required class="w-full rounded-lg border p-2 text-sm" /></div>
            <div id="campos-edicion-recova" class="hidden space-y-4">
              <div><label for="edicion-productor" class="mb-1 block text-sm font-medium text-gray-700">Productor o taller de origen</label><input id="edicion-productor" class="w-full rounded-lg border p-2 text-sm" /></div>
              <div><label for="edicion-categoria" class="mb-1 block text-sm font-medium text-gray-700">Categoría</label><select id="edicion-categoria" class="w-full rounded-lg border p-2 text-sm"><option value="fermentos">Fermentos y alimentos vivos</option><option value="panes_artesanales">Panes artesanales</option><option value="semillas_granos">Semillas y granos</option><option value="conservas_bebidas">Conservas y bebidas</option></select></div>
            </div>
          </div>
          <div><label for="edicion-imagen" class="mb-1 block text-sm font-medium text-gray-700">Imagen</label><input id="edicion-imagen" type="file" accept="image/*" class="w-full text-sm" /><p class="mt-1 text-xs text-gray-500">Si no eliges otra imagen, se conservará la actual.</p></div>
          <div class="flex justify-end gap-2 border-t pt-4"><button type="button" id="btn-cancelar-edicion" class="rounded-lg border px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Cancelar</button><button type="submit" id="btn-guardar-edicion" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700">Guardar cambios</button></div>
        </form>
      </div>

    </div>

  </main>

</Layout>



<script>

  import { auth } from '../lib/firebase';
  import type { CategoriaRecova } from '../lib/firebase';

  import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'firebase/auth';

  import { 

    obtenerPerfilTallerista, 

    actualizarPerfilTallerista, 
    actualizarProducto,
    actualizarTaller,

    crearProducto, 

    getProductosPorTallerista,
    crearTaller,
    getTalleresPorTallerista,
    eliminarTaller,
    esAdministrador,

    cambiarStockProducto,

    eliminarProducto 

  } from '../lib/admin';
  import type { ProductoAdmin, TallerAdmin } from '../lib/admin';
  function getButton(id = '') {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLButtonElement)) throw new Error(`Falta el botón ${id}`);
    return element;
  }

  function getInput(id = '') {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLInputElement)) throw new Error(`Falta el campo ${id}`);
    return element;
  }

  function getTextArea(id = '') {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLTextAreaElement)) throw new Error(`Falta el campo ${id}`);
    return element;
  }

  function getSelect(id = '') {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLSelectElement)) throw new Error(`Falta la selección ${id}`);
    return element;
  }

  function getForm(id = '') {
    const element = document.getElementById(id);
    if (!(element instanceof HTMLFormElement)) throw new Error(`Falta el formulario ${id}`);
    return element;
  }

  let currentUserId = '';
  let elementoEnEdicion: { tipo: 'taller'; item: TallerAdmin } | { tipo: 'producto'; item: ProductoAdmin } | null = null;

  function abrirEdicion(elemento: NonNullable<typeof elementoEnEdicion>) {
    elementoEnEdicion = elemento;
    const modal = document.getElementById('modal-edicion');
    const esTaller = elemento.tipo === 'taller';
    const esRecova = elemento.tipo === 'producto' && elemento.item.tipo === 'mercado';
    document.getElementById('modal-edicion-titulo')!.textContent = esTaller ? 'Editar taller' : 'Editar producto';
    document.getElementById('modal-edicion-subtitulo')!.textContent = esTaller ? 'Actualiza los detalles de tu taller.' : `Edita la publicación de ${esRecova ? 'La Recova' : 'El Aparador'}.`;
    getInput('edicion-titulo').value = elemento.item.titulo || '';
    getTextArea('edicion-descripcion').value = elemento.item.descripcion || '';
    const camposTaller = document.getElementById('campos-edicion-taller');
    const camposProducto = document.getElementById('campos-edicion-producto');
    const camposRecova = document.getElementById('campos-edicion-recova');
    camposTaller?.classList.toggle('hidden', !esTaller);
    camposProducto?.classList.toggle('hidden', esTaller);
    camposRecova?.classList.toggle('hidden', !esRecova);
    getInput('edicion-fechas').value = elemento.tipo === 'taller' ? elemento.item.fechas_horario || '' : '';
    getInput('edicion-fechas').required = esTaller;
    getInput('edicion-precio').required = !esTaller;
    getInput('edicion-productor').required = esRecova;
    getSelect('edicion-categoria').required = esRecova;
    if (elemento.tipo === 'producto') {
      getInput('edicion-precio').value = String(elemento.item.precio ?? '');
      getInput('edicion-productor').value = elemento.item.productor || '';
      getSelect('edicion-categoria').value = elemento.item.categoria || 'fermentos';
    }
    getInput('edicion-imagen').value = '';
    document.getElementById('modal-edicion-error')?.classList.add('hidden');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    getInput('edicion-titulo').focus();
  }

  function cerrarEdicion() {
    const modal = document.getElementById('modal-edicion');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    elementoEnEdicion = null;
  }

  document.getElementById('btn-cerrar-edicion')?.addEventListener('click', cerrarEdicion);
  document.getElementById('btn-cancelar-edicion')?.addEventListener('click', cerrarEdicion);
  document.getElementById('modal-edicion')?.addEventListener('click', (event) => {
    if (event.target === document.getElementById('modal-edicion')) cerrarEdicion();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && elementoEnEdicion) cerrarEdicion();
  });

  document.getElementById('form-edicion')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const elemento = elementoEnEdicion;
    if (!elemento) return;
    const boton = getButton('btn-guardar-edicion');
    const error = document.getElementById('modal-edicion-error');
    boton.disabled = true;
    boton.textContent = 'Guardando...';
    error?.classList.add('hidden');
    try {
      let imagenUrl = elemento.item.imagen_url;
      const archivo = getInput('edicion-imagen').files?.[0];
      if (archivo) {
        const contenedor = document.getElementById('main-container');
        const cloudName = contenedor?.dataset.cloud;
        const uploadPreset = contenedor?.dataset.preset;
        if (!cloudName || !uploadPreset) throw new Error('Falta configurar la carga de imágenes.');
        const datos = new FormData();
        datos.append('file', archivo);
        datos.append('upload_preset', uploadPreset);
        const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, { method: 'POST', body: datos });
        const resultado = await response.json();
        if (!response.ok || !resultado.secure_url) throw new Error('No se pudo cargar la nueva imagen.');
        imagenUrl = resultado.secure_url;
      }
      const contenido = {
        titulo: getInput('edicion-titulo').value.trim(),
        descripcion: getTextArea('edicion-descripcion').value.trim(),
        imagen_url: imagenUrl
      };
      if (elemento.tipo === 'taller') {
        await actualizarTaller(elemento.item.id, { ...contenido, fechas_horario: getInput('edicion-fechas').value.trim() });
        await cargarMisTalleres();
      } else {
        if (elemento.item.tipo === 'mercado' && !await esAdministrador(currentUserId)) throw new Error('Esta cuenta no tiene permisos de administrador.');
        await actualizarProducto(elemento.item.id, {
          ...contenido,
          precio: Number(getInput('edicion-precio').value),
          tipo: elemento.item.tipo === 'mercado' ? 'mercado' : 'arte',
          ...(elemento.item.tipo === 'mercado' ? {
            productor: getInput('edicion-productor').value.trim(),
            categoria: getSelect('edicion-categoria').value as CategoriaRecova
          } : {})
        });
        await cargarMisProductos();
      }
      cerrarEdicion();
    } catch (err) {
      if (error) {
        error.textContent = err instanceof Error ? err.message : 'No se pudieron guardar los cambios. Inténtalo de nuevo.';
        error.classList.remove('hidden');
      }
    } finally {
      boton.disabled = false;
      boton.textContent = 'Guardar cambios';
    }
  });



  const seccionLogin = document.getElementById('seccion-login');

  const seccionDashboard = document.getElementById('seccion-dashboard');



  // 1. Escuchar estado de Autenticación

  onAuthStateChanged(auth, async (user) => {

    if (user) {

      // SI HAY USUARIO: Ocultar login, mostrar dashboard

      currentUserId = user.uid;

      if (seccionLogin) seccionLogin.classList.add('hidden');

      if (seccionDashboard) seccionDashboard.classList.remove('hidden');



      const saludo = document.getElementById('saludo-user');

      if (saludo) saludo.textContent = `Sesión activa: ${user.email}`;



      await cargarPerfil();

      const esAdmin = await esAdministrador(currentUserId).catch(() => false);
      document.getElementById('seccion-recova-admin')?.classList.toggle('hidden', !esAdmin);



      await cargarMisTalleres();

      await cargarMisProductos();

    } else {

      // SI NO HAY USUARIO: Mostrar login, ocultar dashboard

      if (seccionLogin) seccionLogin.classList.remove('hidden');

      if (seccionDashboard) seccionDashboard.classList.add('hidden');

    }

  });



  // 2. Lógica de Inicio de Sesión

  document.getElementById('form-login')?.addEventListener('submit', async (e) => {

    e.preventDefault();

    const btn = getButton('btn-login');

    const msg = document.getElementById('msg-login-error');

    const email = (getInput('login-email')).value;

    const password = (getInput('login-password')).value;



    btn.disabled = true;

    btn.textContent = 'Verificando...';

    if (msg) msg.classList.add('hidden');



    try {

      await signInWithEmailAndPassword(auth, email, password);

      // Al tener éxito, onAuthStateChanged se dispara solo y cambia la pantalla

      (getForm('form-login')).reset();

    } catch (err) {

      if (msg) {

        msg.textContent = 'Credenciales incorrectas. Intenta de nuevo.';

        msg.classList.remove('hidden');

      }

    } finally {

      btn.disabled = false;

      btn.textContent = 'Ingresar al Panel';

    }

  });



  // Logout

  document.getElementById('btn-logout')?.addEventListener('click', () => signOut(auth));



  // 3. Cargar Perfil Existente

  async function cargarPerfil() {

    const perfil = await obtenerPerfilTallerista(currentUserId);

    if (perfil) {

      (getInput('perfil-nombre')).value = perfil.nombre || '';

      (getTextArea('perfil-bio')).value = perfil.bio || '';

      (getInput('perfil-whatsapp')).value = perfil.whatsapp_ventas || '';
      const fotoPreview = document.getElementById('perfil-foto-preview');
      if (fotoPreview instanceof HTMLImageElement && perfil.foto_url) fotoPreview.src = perfil.foto_url;

    }

  }



  // 4. Guardar Perfil

  document.getElementById('form-perfil')?.addEventListener('submit', async (e) => {

    e.preventDefault();

    const btn = getButton('btn-guardar-perfil');

    const msg = document.getElementById('msg-perfil');



    btn.disabled = true;

    btn.textContent = 'Guardando...';



    try {
      let fotoUrl: string | undefined;
      const fotoInput = getInput('perfil-foto');
      const mainContainer = document.getElementById('main-container');
      const cloudName = mainContainer?.dataset.cloud;
      const uploadPreset = mainContainer?.dataset.preset;
      if (fotoInput.files?.[0]) {
        if (!cloudName || !uploadPreset) throw new Error('Cloudinary no está configurado.');
        const formData = new FormData();
        formData.append('file', fotoInput.files[0]);
        formData.append('upload_preset', uploadPreset);
        const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, { method: 'POST', body: formData });
        const imageData = await response.json();
        if (!response.ok || !imageData.secure_url) throw new Error('No se pudo subir la foto.');
        fotoUrl = imageData.secure_url;
      }
      await actualizarPerfilTallerista(currentUserId, {

        nombre: (getInput('perfil-nombre')).value,

        bio: (getTextArea('perfil-bio')).value,

        contacto: '',

        whatsapp_ventas: (getInput('perfil-whatsapp')).value,
        ...(fotoUrl ? { foto_url: fotoUrl } : {})

      });
      const fotoPreview = document.getElementById('perfil-foto-preview');
      if (fotoPreview instanceof HTMLImageElement && fotoUrl) fotoPreview.src = fotoUrl;



      if (msg) {

        msg.className = 'p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-800 border border-emerald-200 block';

        msg.textContent = '✅ Perfil actualizado correctamente.';

      }

    } catch (err) {

      if (msg) {

        msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 border border-red-200 block';

        msg.textContent = '❌ Error al guardar perfil.';

      }

    } finally {

      btn.disabled = false;

      btn.textContent = 'Guardar Perfil';

    }

  });




  // 6. Publicar un taller (imagen en Cloudinary y datos en Firestore)
  document.getElementById('form-taller')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = getButton('btn-guardar-taller');
    const msg = document.getElementById('msg-taller');
    const fileInput = getInput('taller-imagen');
    const mainContainer = document.getElementById('main-container');
    const cloudName = mainContainer?.dataset.cloud;
    const uploadPreset = mainContainer?.dataset.preset;

    if (!fileInput.files || fileInput.files.length === 0) return;
    if (!cloudName || !uploadPreset) {
      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 border border-red-200 block'; msg.textContent = '❌ Falta configurar la carga de imágenes.'; }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Subiendo imagen...';
    if (msg) msg.classList.add('hidden');

    try {
      const formData = new FormData();
      formData.append('file', fileInput.files[0]);
      formData.append('upload_preset', uploadPreset);
      const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok || !data.secure_url) throw new Error('No se pudo subir la imagen.');

      btn.textContent = 'Guardando taller...';
      await crearTaller({
        id_tallerista: currentUserId,
        titulo: (getInput('taller-titulo')).value.trim(),
        descripcion: (getTextArea('taller-descripcion')).value.trim(),
        fechas_horario: (getInput('taller-fechas-horario')).value.trim(),
        imagen_url: data.secure_url
      });

      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-800 border border-emerald-200 block'; msg.textContent = '✅ Taller publicado correctamente.'; }
      (getForm('form-taller')).reset();
      await cargarMisTalleres();
    } catch (err) {
      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 border border-red-200 block'; msg.textContent = '❌ Error al publicar el taller. Revisa la imagen y vuelve a intentarlo.'; }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Publicar Taller';
    }
  });

  // 7. Cargar y gestionar los talleres del instructor
  async function cargarMisTalleres() {
    const contenedor = document.getElementById('lista-mis-talleres');
    if (!contenedor || !currentUserId) return;
    contenedor.innerHTML = '<p class="text-gray-400 text-sm">Cargando tus talleres...</p>';

    try {
      const talleres = await getTalleresPorTallerista(currentUserId);
      if (talleres.length === 0) {
        contenedor.innerHTML = '<p class="text-gray-500 text-sm">Aún no has publicado talleres.</p>';
        return;
      }
      contenedor.innerHTML = talleres.map((taller) => `
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 border rounded-lg bg-gray-50 hover:bg-white transition-colors gap-4">
          <div class="flex items-center gap-3 min-w-0">
            <img src="${taller.imagen_url || ''}" alt="${taller.titulo || 'Taller'}" class="w-14 h-14 object-cover rounded-md border" />
            <div class="min-w-0">
              <h4 class="font-bold text-gray-800 text-sm">${taller.titulo || 'Taller sin título'}</h4>
              <p class="text-xs text-gray-500">${taller.fechas_horario || ''}</p>
              <p class="text-xs text-emerald-700 font-semibold">${taller.activo ? 'Publicado' : 'Inactivo'}</p>
            </div>
          </div>
          <div class="flex w-full gap-2 sm:w-auto"><button type="button" data-taller-id="${taller.id}" class="btn-editar-taller flex-1 rounded border border-emerald-200 px-3 py-1.5 text-xs font-medium text-emerald-700 hover:bg-emerald-50 sm:flex-none">Editar</button><button type="button" data-taller-id="${taller.id}" class="btn-eliminar-taller flex-1 rounded bg-red-50 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-100 sm:flex-none">Eliminar</button></div>
        </div>
      `).join('');

      contenedor.querySelectorAll('.btn-eliminar-taller').forEach((boton) => {
        boton.addEventListener('click', async (e) => {
          if (!confirm('¿Seguro que deseas eliminar este taller?')) return;
          const target = e.currentTarget;
          if (!(target instanceof HTMLButtonElement)) return;
          const id = target.getAttribute('data-taller-id');
          if (!id) return;
          target.disabled = true;
          try {
            await eliminarTaller(id);
            await cargarMisTalleres();
          } catch (err) {
            target.disabled = false;
            alert('No se pudo eliminar el taller. Inténtalo de nuevo.');
          }
        });
      });
      contenedor.querySelectorAll('.btn-editar-taller').forEach((boton) => {
        boton.addEventListener('click', () => {
          if (!(boton instanceof HTMLButtonElement)) return;
          const item = talleres.find((taller) => taller.id === boton.dataset.tallerId);
          if (item) abrirEdicion({ tipo: 'taller', item });
        });
      });
    } catch (err) {
      contenedor.innerHTML = '<p class="text-red-600 text-sm">No se pudieron cargar tus talleres. Inténtalo de nuevo.</p>';
    }
  }

  document.getElementById('form-recova')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = getButton('btn-guardar-recova');
    const msg = document.getElementById('msg-recova');
    const fileInput = getInput('recova-imagen');
    const mainContainer = document.getElementById('main-container');
    const cloudName = mainContainer?.dataset.cloud;
    const uploadPreset = mainContainer?.dataset.preset;
    if (!fileInput.files?.[0] || !cloudName || !uploadPreset) {
      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 block'; msg.textContent = 'Selecciona una imagen y verifica la configuración de imágenes.'; }
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Subiendo imagen...';
    try {
      if (!await esAdministrador(currentUserId)) throw new Error('Esta cuenta no tiene permisos de administrador.');
      const formData = new FormData();
      formData.append('file', fileInput.files[0]);
      formData.append('upload_preset', uploadPreset);
      const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, { method: 'POST', body: formData });
      const imageData = await response.json();
      if (!response.ok || !imageData.secure_url) throw new Error('Falló la carga de imagen.');
      btn.textContent = 'Guardando producto...';
      await crearProducto({
        id_tallerista: currentUserId,
        titulo: getInput('recova-titulo').value.trim(),
        descripcion: getTextArea('recova-descripcion').value.trim(),
        precio: Number(getInput('recova-precio').value),
        imagen_url: imageData.secure_url,
        tipo: 'mercado',
        productor: getInput('recova-productor').value.trim(),
        categoria: getSelect('recova-categoria').value as CategoriaRecova
      });
      (getForm('form-recova')).reset();
      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-800 block'; msg.textContent = 'Producto publicado en La Recova.'; }
      await cargarMisProductos();
    } catch (error) {
      if (msg) { msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 block'; msg.textContent = 'No se pudo publicar. Verifica el rol de administrador e inténtalo otra vez.'; }
    } finally {
      btn.disabled = false;
      btn.textContent = 'Publicar en La Recova';
    }
  });

  // 5. Subir Producto

  document.getElementById('form-producto')?.addEventListener('submit', async (e) => {

    e.preventDefault();

    const btn = getButton('btn-guardar-producto');

    const msg = document.getElementById('msg-producto');

    const fileInput = getInput('prod-imagen');



    if (!fileInput.files || fileInput.files.length === 0) return;



    btn.disabled = true;

    btn.textContent = 'Subiendo imagen...';



    try {

      // Leer las variables del contenedor

      const mainContainer = document.getElementById('main-container');

      const cloudName = mainContainer?.dataset.cloud;

      const uploadPreset = mainContainer?.dataset.preset;



      const formData = new FormData();

      formData.append('file', fileInput.files[0]);

      formData.append('upload_preset', uploadPreset || ''); 



      const res = await fetch(`https\://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {

        method: 'POST',

        body: formData

      });

      const data = await res.json();



      btn.textContent = 'Guardando producto...';



      await crearProducto({

        id_tallerista: currentUserId,

        titulo: (getInput('prod-titulo')).value,

        descripcion: (getTextArea('prod-descripcion')).value,

        precio: parseFloat((getInput('prod-precio')).value),

        imagen_url: data.secure_url || 'https://picsum.photos/400/300',
        tipo: getSelect('prod-tipo').value === 'mercado' ? 'mercado' : 'arte'

      });



      if (msg) {

        msg.className = 'p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-800 border border-emerald-200 block';

        msg.textContent = '✅ Producto publicado en el catálogo al instante.';

      }



      (getForm('form-producto')).reset();

      await cargarMisProductos(); 

    } catch (err) {

      if (msg) {

        msg.className = 'p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-800 border border-red-200 block';

        msg.textContent = '❌ Error al publicar producto.';

      }

    } finally {

      btn.disabled = false;

      btn.textContent = 'Publicar Producto';

    }

  });



  // 6. Cargar y Gestionar Productos del Instructor

  async function cargarMisProductos() {

    const contenedor = document.getElementById('lista-mis-productos');

    if (!contenedor) return;



    const productos = await getProductosPorTallerista(currentUserId);



    if (productos.length === 0) {

      contenedor.innerHTML = '<p class="text-gray-500 text-sm">Aún no has publicado productos.</p>';

      return;

    }



    contenedor.innerHTML = productos.map((p) => `

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 border rounded-lg bg-gray-50 hover:bg-white transition-colors gap-4">

        <div class="flex items-center gap-3">

          <img src="${p.imagen_url}" alt="${p.titulo}" class="w-12 h-12 object-cover rounded-md border" onerror="this.src='https\://picsum.photos/400/300'" />

          <div>

            <h4 class="font-bold text-gray-800 text-sm">${p.titulo}</h4>

            <p class="text-xs text-gray-500">$${p.precio} MXN — ${p.en_stock ? '<span class="text-emerald-600 font-semibold">En Stock</span>' : '<span class="text-red-500 font-semibold">Agotado</span>'}</p>

          </div>

        </div>

        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">

          <button data-id="${p.id}" class="btn-editar-prod flex-1 sm:flex-none text-xs px-3 py-1.5 rounded border border-emerald-200 hover:bg-emerald-50 text-emerald-700 font-medium">Editar</button>

          <button data-id="${p.id}" data-stock="${p.en_stock}" class="btn-toggle-stock flex-1 sm:flex-none text-xs px-3 py-1.5 rounded border border-gray-300 hover:bg-gray-100 text-gray-700">

            ${p.en_stock ? 'Marcar Agotado' : 'Marcar Disponible'}

          </button>

          <button data-id="${p.id}" class="btn-eliminar-prod flex-1 sm:flex-none text-xs px-3 py-1.5 rounded bg-red-50 hover:bg-red-100 text-red-600 font-medium">

            Eliminar

          </button>

        </div>

      </div>

    `).join('');



    // Asignar eventos a los botones dinámicos

    contenedor.querySelectorAll('.btn-toggle-stock').forEach(btn => {

      btn.addEventListener('click', async (e) => {

        const target = e.currentTarget;
        if (!(target instanceof HTMLButtonElement)) return;

        const id = target.getAttribute('data-id');

        if (!id) return;
        const stockActual = target.getAttribute('data-stock') === 'true';

        await cambiarStockProducto(id, stockActual);

        await cargarMisProductos();

      });

    });



    contenedor.querySelectorAll('.btn-eliminar-prod').forEach(btn => {

      btn.addEventListener('click', async (e) => {

        if (!confirm('¿Seguro que deseas eliminar este producto del catálogo?')) return;

        const target = e.currentTarget;
        if (!(target instanceof HTMLButtonElement)) return;

        const id = target.getAttribute('data-id');

        if (!id) return;
        await eliminarProducto(id);

        await cargarMisProductos();

      });

    });

    contenedor.querySelectorAll('.btn-editar-prod').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const item = productos.find((producto) => producto.id === btn.dataset.id);
        if (item) abrirEdicion({ tipo: 'producto', item });
      });
    });

  }

</script>
